<main class="dashboard-content" id="main-content">
  {{> message}}
  <section class="exam-banner" aria-labelledby="exam-heading">
    <span class="calendar-icon" aria-hidden="true">&#128197;</span>
    <div class="exam-summary">
      <h2 class="exam-heading" id="exam-heading">Your next exam</h2>
      <p class="exam-description">Your exam date and days remaining will appear here.</p>
      <div class="exam-progress-track" role="progressbar" aria-label="Exam preparation: no exam added" aria-valuemin="0" aria-valuemax="100" aria-valuenow="0">
        <span class="exam-progress-fill"></span>
      </div>
    </div>
    <span class="exam-status">No exam added yet</span>
  </section>

  <div class="streak-container">
    <div class="streak-card">
            <h2>{{currentStreak}} Day Streak</h2>
        </div>
    </div>

    <div class="streak-card">
        

        
            <h2>Longest Streak: {{longestStreak}} Days</h2>
            
        </div>
    </div>
</div>

  <h1 class="welcome-heading">Welcome back{{#if username}}, {{username}}{{/if}}.</h1>
  <p class="welcome-description">A fresh start for your next study session.</p>

  <section class="dashboard-card create-card" aria-labelledby="create-heading">
    <h2 class="card-heading" id="create-heading">Create something new</h2>
    <h3 class="card-title">Big ideas, bite-sized cards.</h3>
    <p class="card-description">Build a flashcard set and make it stick.</p>
    <a class="create-button" id="open-create-set" href="/decks/new" aria-haspopup="dialog">Create new set</a>
  </section>

  <section class="dashboard-card" aria-labelledby="recent-heading">
    <h2 class="card-heading" id="recent-heading">Your sets</h2>
    {{#each recentSets}}
      <article class="recent-set">
        <h3 class="card-title"><a href="/decks/{{deck_id}}">{{name}}</a></h3>
        <p class="card-description">{{cardCount}} cards</p>
        <nav class="set-actions" aria-label="Manage {{name}}">
          <a href="/decks/{{deck_id}}/edit">Edit</a>
          <a href="/decks/{{deck_id}}/rename">Rename</a>
          <a class="danger-link" href="/decks/{{deck_id}}/delete">Delete</a>
        </nav>
      </article>
    {{else}}
      <p class="card-description">Your saved flashcard sets will appear here.</p>
    {{/each}}
  </section>
</main>

<dialog class="set-dialog" id="new-set-dialog" aria-labelledby="new-set-heading">
  <form action="/decks/new" method="post" id="new-set-details">
    <h2 id="new-set-heading">Create a new set</h2>
    <p class="card-description">Give your set a name, then start adding cards.</p>
    <label class="field-label" for="new-set-title">Name</label>
    <input class="field-input" id="new-set-title" name="title" maxlength="100" required autofocus>
    <label class="field-label" for="new-set-description">Description (optional)</label>
    <textarea class="field-input" id="new-set-description" name="description" rows="3"></textarea>
    <div class="set-dialog-actions">
      <button class="create-button" id="cancel-create-set" type="button">Cancel</button>
      <button class="submit-button" type="submit">Continue to cards</button>
    </div>
  </form>
</dialog>
<script src="/js/new-set-dialog.js" defer></script>
